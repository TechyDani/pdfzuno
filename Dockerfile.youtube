FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3-venv ca-certificates \
    && python3 -m venv /opt/ytdlp \
    && /opt/ytdlp/bin/pip install --no-cache-dir "yt-dlp[default]" \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/ytdlp/bin:${PATH}" PORT=8787 NODE_ENV=production
WORKDIR /app
COPY --chown=node:node package.json ./
COPY --chown=node:node lib/youtube ./lib/youtube
COPY --chown=node:node scripts/youtube-service.mjs ./scripts/youtube-service.mjs
USER node
EXPOSE 8787
CMD ["node", "--experimental-strip-types", "scripts/youtube-service.mjs"]
